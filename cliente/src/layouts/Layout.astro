---
import '../styles/global.css';
import SocialIcons from '../components/SocialIcons.astro';
import { getCategorias } from '../lib/strapi';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}

const { 
  title = 'OIFB',
  description,
  image,
  type = 'website',
  publishedTime,
} = Astro.props;

const categorias = await getCategorias().catch(() => []);

// Ruta actual para detectar el enlace activo
const currentPath = Astro.url.pathname;

// Helper: ¿el enlace está activo?
function isActive(href: string): boolean {
  // Coincidencia exacta para "/"
  if (href === '/') return currentPath === '/';
  // Coincidencia por prefijo (para /categoria/slug y /categoria/slug/page/2)
  return currentPath === href || currentPath.startsWith(href + '/');
}
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link 
      rel="alternate" 
      type="application/rss+xml" 
      title="OIFB — RSS" 
      href={`${Astro.site}rss.xml`} 
    />
  </head>
  <body 
    class="bg-gray-50 font-sans text-gray-900"
    style="display: flex; flex-direction: column; min-height: 100vh; margin: 0;"
  >
    <header class="bg-white border-b shadow-sm">
      <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between gap-6">
        
        <!-- Logo -->
        <a href="/" class="text-2xl font-bold hover:text-blue-700 shrink-0 transition-colors">
          OIFB
        </a>

        <!-- Navegación desktop -->
        <nav class="hidden md:flex gap-1 text-sm flex-1 justify-center">
          {categorias.map((cat) => {
            const href = `/categoria/${cat.slug}`;
            const activo = isActive(href);
            return (
              <a 
                href={href}
                class:list={[
                  'px-3 py-2 rounded-md transition-all duration-200 relative',
                  activo 
                    ? 'text-blue-700 font-semibold bg-blue-50' 
                    : 'text-gray-700 hover:text-blue-700 hover:bg-gray-50'
                ]}
                aria-current={activo ? 'page' : undefined}
              >
                {cat.nombre}
                {activo && (
                  <span class="absolute bottom-0 left-3 right-3 h-0.5 bg-blue-700 rounded-full"></span>
                )}
              </a>
            );
          })}
          
          <!-- Enlace "Todas" -->
          {(() => {
            const activo = isActive('/categorias');
            return (
              <a 
                href="/categorias"
                class:list={[
                  'px-3 py-2 rounded-md transition-all duration-200 relative',
                  activo 
                    ? 'text-blue-700 font-semibold bg-blue-50' 
                    : 'font-semibold text-gray-700 hover:text-blue-700 hover:bg-gray-50'
                ]}
                aria-current={activo ? 'page' : undefined}
              >
                Todas
                {activo && (
                  <span class="absolute bottom-0 left-3 right-3 h-0.5 bg-blue-700 rounded-full"></span>
                )}
              </a>
            );
          })()}
        </nav>

        <!-- Iconos sociales (derecha) -->
        <div class="hidden md:block shrink-0">
          <SocialIcons size={18} />
        </div>

        <!-- Menú móvil -->
        <details class="md:hidden relative">
          <summary class="list-none cursor-pointer p-2 hover:bg-gray-100 rounded">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </summary>
          <nav class="absolute right-0 top-full mt-2 bg-white border rounded-lg shadow-lg py-2 min-w-[220px] z-20">
            {categorias.map((cat) => {
              const href = `/categoria/${cat.slug}`;
              const activo = isActive(href);
              return (
                <a 
                  href={href}
                  class:list={[
                    'block px-4 py-2 text-sm transition-colors',
                    activo 
                      ? 'text-blue-700 font-semibold bg-blue-50 border-l-2 border-blue-700' 
                      : 'text-gray-700 hover:bg-gray-50 hover:text-blue-700'
                  ]}
                >
                  {cat.nombre}
                </a>
              );
            })}
            <a 
              href="/categorias" 
              class:list={[
                'block px-4 py-2 text-sm font-semibold border-t mt-1 pt-2 transition-colors',
                isActive('/categorias')
                  ? 'text-blue-700 bg-blue-50'
                  : 'text-gray-700 hover:bg-gray-50 hover:text-blue-700'
              ]}
            >
              Ver todas
            </a>
            <div class="px-4 py-3 border-t mt-2">
              <SocialIcons size={18} />
            </div>
          </nav>
        </details>
      </div>
    </header>

    <main 
      class="max-w-5xl mx-auto px-6 py-10"
      style="flex: 1; width: 100%;"
    >
      <slot />
    </main>

    <footer class="bg-white border-t mt-16">
      <div class="max-w-5xl mx-auto px-6 py-8">
        <div class="flex flex-col items-center gap-4">
          <SocialIcons size={20} />
          <p class="text-sm text-gray-500 text-center">
            © {new Date().getFullYear()} OIFB — Observatorio de Ideas Filosóficas y Políticas
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>