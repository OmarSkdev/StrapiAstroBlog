---
import Layout from '../../layouts/Layout.astro';
import ArticuloCard from '../../components/ArticuloCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getCategorias, getArticulosByCategoriaPaginados } from '../../lib/strapi';


export async function getStaticPaths() {
  const PAGE_SIZE = 3;

  const categorias = await getCategorias().catch(() => []);
  const paths = [];

  for (const cat of categorias) {
    // Primera página de la categoría
    const { articulos, pagination } = await getArticulosByCategoriaPaginados(cat.slug, 1, PAGE_SIZE);
    paths.push({
      params: { slug: cat.slug },
      props: { categoria: cat, articulos, pagination },
    });

    // Páginas 2, 3, 4... de la categoría
    for (let page = 2; page <= pagination.pageCount; page++) {
      const { articulos: arts, pagination: pag } = await getArticulosByCategoriaPaginados(cat.slug, page, PAGE_SIZE);
      paths.push({
        params: { slug: `${cat.slug}/page/${page}` },  // ⚠️ Ver nota abajo
        props: { categoria: cat, articulos: arts, pagination: pag },
      });
    }
  }
  return paths;
}

const { categoria, articulos, pagination } = Astro.props;
---
<Layout title={categoria.nombre}>
  <a href="/" class="text-blue-600 hover:underline mb-6 inline-block">← Volver al inicio</a>

  <header class="mb-10">
    <h1 class="text-4xl font-bold mb-2">{categoria.nombre}</h1>
    {categoria.descripcion && <p class="text-lg text-gray-600">{categoria.descripcion}</p>}
    <p class="text-sm text-gray-500 mt-2">{pagination.total} artículo(s)</p>
  </header>

  {articulos.length === 0 ? (
    <p class="text-gray-500">No hay artículos en esta categoría todavía.</p>
  ) : (
    <>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {articulos.map((articulo) => (
          <ArticuloCard articulo={articulo} />
        ))}
      </div>

      <Pagination 
        currentPage={pagination.page} 
        totalPages={pagination.pageCount} 
        baseUrl={`/categoria/${categoria.slug}`} 
      />
    </>
  )}
</Layout>