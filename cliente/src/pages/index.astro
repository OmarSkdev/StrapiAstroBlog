---
import Layout from '../layouts/Layout.astro';
import ArticuloCard from '../components/ArticuloCard.astro';
import Pagination from '../components/Pagination.astro';
import { getArticulosPaginados } from '../lib/strapi';

const PAGE_SIZE = 3;
const { articulos, pagination } = await getArticulosPaginados(1, PAGE_SIZE);
---
<Layout title="Inicio">
  <header class="mb-12 text-center">
    <h1 class="text-4xl font-bold mb-2">Publicaciones Recientes</h1>
    <p class="text-gray-600">Reflexiones sobre historia, economía, política y filosofía</p>
  </header>

  {articulos.length === 0 ? (
    <p class="text-center text-gray-500 py-12">No hay artículos publicados todavía.</p>
  ) : (
    <>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {articulos.map((articulo) => (
          <ArticuloCard articulo={articulo} />
        ))}
      </div>

      <Pagination 
        currentPage={pagination.page} 
        totalPages={pagination.pageCount} 
        baseUrl="" 
      />
    </>
  )}
</Layout>