---
import Layout from '../layouts/Layout.astro';
import { getCategorias, getArticulos } from '../lib/strapi';

const categorias = await getCategorias().catch(() => []);
const articulos = await getArticulos().catch(() => []);
---
<Layout title="Categorías">
  <a href="/" class="text-blue-600 hover:underline mb-6 inline-block">← Volver al inicio</a>
  <h1 class="text-4xl font-bold mb-8">Todas las Categorías</h1>

  <ul class="space-y-6">
    {categorias.map((cat) => {
      const count = articulos.filter((a) => 
        a.categorias?.some((c) => c.slug === cat.slug)
      ).length;
      return (
        <li class="border-l-4 pl-4" style={`border-color: ${cat.color || '#6B7280'}`}>
          <h2 class="text-2xl font-semibold">
            <a href={`/categoria/${cat.slug}`} class="hover:text-blue-600">
              {cat.nombre}
            </a>
          </h2>
          {cat.descripcion && (
            <p class="text-gray-600 mt-1">{cat.descripcion}</p>
          )}
          <p class="text-sm text-gray-500 mt-1">{count} artículo(s)</p>
        </li>
      );
    })}
  </ul>
</Layout>